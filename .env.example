# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/invoice-anomaly

# Vultr Serverless Inference
VULTR_INFERENCE_API_KEY=your-vultr-api-key-here
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
MODEL_NAME=meta/llama-3.1-70b-instruct

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Security
CORS_ORIGIN=http://localhost:5173
ADMIN_TOKEN=generate-a-secure-32-character-token-here

# Logging
LOG_LEVEL=info
